prefix=/usr/local/ffmpeg_static
exec_prefix=${prefix}
libdir=/usr/local/ffmpeg_static/lib
includedir=/usr/local/ffmpeg_static/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.2.100
Requires: libavfilter >= 11.9.100, libswscale >= 9.3.100, libavformat >= 62.6.101, libavcodec >= 62.19.100, libswresample >= 6.2.100, libavutil >= 60.17.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavdevice -lm -latomic -ldrm -lxcb -lasound -lsndio -lXv -lX11 -lXext
Libs.private: 
Cflags: -I${includedir}

prefix=/usr/local/ffmpeg_static
exec_prefix=${prefix}
libdir=/usr/local/ffmpeg_static/lib
includedir=/usr/local/ffmpeg_static/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.9.100
Requires: libswscale >= 9.3.100, libavformat >= 62.6.101, libavcodec >= 62.19.100, libswresample >= 6.2.100, libavutil >= 60.17.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavfilter -pthread -lm -latomic
Libs.private: 
Cflags: -I${includedir}
